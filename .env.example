# По умолчанию используется SQLite для локального запуска.
# Для Microsoft SQL Server укажите строку подключения SQLAlchemy:
# DATABASE_URL=mssql+pyodbc://USER:PASSWORD@SERVER/DATABASE?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
DATABASE_URL=sqlite:///../proect_manager.db
SECRET_KEY=replace-this-with-a-long-random-secret
FLASK_DEBUG=0
